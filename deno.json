{
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "LUME_DRAFTS=false deno task lume -s",
    "serve:host": "LUME_DRAFTS=false deno task lume -s --hostname 0.0.0.0",
    "serve:drafts": "LUME_DRAFTS=true deno task lume -s",
    "test": "deno test -A",
    "drafts": "deno run --allow-read scripts/drafts.ts",
    "new:post": "deno run --allow-write scripts/post.ts",
    "new:device": "deno run --allow-write scripts/device.ts",
    "stats": "deno run --allow-read scripts/stats.ts",
    "convert:webp": "deno run --allow-read --allow-write scripts/images-converter.ts",
    "todo:init": "deno run --allow-read --allow-write scripts/todo.ts init",
    "todo:list": "deno run --allow-read scripts/todo.ts list",
    "todo:add": "deno run --allow-read --allow-write scripts/todo.ts add",
    "todo:remove": "deno run --allow-read --allow-write scripts/todo.ts remove",
    "todo:done": "deno run --allow-read --allow-write scripts/todo.ts done",
    "fonts:download": "deno run --allow-read --allow-write --allow-net scripts/fonts-download.ts"
  },
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/",
    "alpinejs": "npm:alpinejs@3.17.4",
    "zod": "npm:zod@4.6.5",
    "@std/expect": "jsr:@std/expect@1.0.20",
    "@std/testing": "jsr:@std/testing@1.0.20",
    "@cliffy/table": "jsr:@cliffy/table@1.0.0-rc.7",
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@cross/image": "jsr:@cross/image",
    "@std/yaml": "jsr:@std/yaml@1.1.0"
  },
  "compilerOptions": {
    "types": ["lume/types.ts"],
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "lint": {
    "plugins": ["https://deno.land/x/lume@v3.2.5/lint.ts"]
  }
}
