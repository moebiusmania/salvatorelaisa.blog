{{- set items = [
  { name: "Cerca", href: "/post/page/1", title: "Tutti gli articoli del blog" },
  { name: "About", href: "/about", title: "Qualche riga su di me" },
  { name: "Tags", href: "/tags", title: "Articoli per tag" },
  { name: "Adesso", href: "/now", title: "Cosa sto facendo in questo periodo" },
] }}
{{- set event = config.SEASON_EVENT }}
{{- set nav = event ? [event, ...items] : items }}
{{- set current = (url || "").replace(/\/$/, "") || "/" }}
<header class="header">
  <div>
    <a href="/">
      <img src="/static/images/avatar.webp" alt="Il mio avatar in pixel art" />
      <span>{{ config.SITE_TITLE }}</span>
      <span>{{ config.SEASON_EMOJI }}</span>
    </a>
    <nav>
      {{- for index, item of nav }}
      <a title="{{ item.title }}" class="navitem{{ item.href === current ? ' router-link-active' : '' }}{{ event && index === 0 ? ' event-nav' : '' }}" href="{{ item.href }}" target="{{ item.external ? '_blank' : '_self' }}"{{ item.external ? ' rel="noopener noreferrer"' : '' }}>{{ item.name }}</a>
      {{- /for }}
      <a class="navitem" aria-label="theme switcher" href="#" id="theme" x-data="themeToggle" @click.prevent="toggle">
        <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor">
          <path x-show="dark" style="display: none" class="sun" fill-rule="evenodd"
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            clip-rule="evenodd"></path>
          <path x-show="!dark" class="moon" d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>
