{{# Snowfall in three depth layers: many tiny, slow, faint flakes far away, a
    middle layer of soft dots, and a few large crystal glyphs up close that
    fall fastest. Layer, position, speed and sway are computed once at build
    time, so each build bakes a fixed (but organic-looking) snowfall.
    U+FE0E keeps the crystals as text glyphs, so they take the theme colour
    instead of being swapped for a platform emoji. #}}
{{- set glyphs = ["❄︎", "❅︎", "❆︎"] }}
{{- set rand = (min, max) => min + Math.random() * (max - min) }}
{{- set layers = {
  far: { fall: [22, 34], size: [2, 3] },
  mid: { fall: [14, 21], size: [3, 5] },
  near: { fall: [9, 13], size: [0.8, 1.3] },
} }}
<div class="snow" aria-hidden="true">
  {{- for index of Array.from({ length: count || 42 }, (_, i) => i) }}
  {{- set roll = Math.random() }}
  {{- set layer = roll < 0.5 ? "far" : roll < 0.85 ? "mid" : "near" }}
  {{- set spec = layers[layer] }}
  {{- set fall = rand(spec.fall[0], spec.fall[1]) }}
  {{- set size = rand(spec.size[0], spec.size[1]) }}
  <div class="flake flake--{{ layer }}" style="--x:{{ rand(0, 100).toFixed(1) }}%;--fall:{{ fall.toFixed(1) }}s;--delay:{{ (-rand(0, fall)).toFixed(1) }}s;--size:{{ size.toFixed(2) }}{{ layer === 'near' ? 'rem' : 'px' }};--sway:{{ rand(8, 40).toFixed(0) }}px;--sway-time:{{ rand(3, 7).toFixed(1) }}s;">
    <span>{{ layer === "near" ? glyphs[Math.floor(Math.random() * glyphs.length)] : "" }}</span>
  </div>
  {{- /for }}
</div>
