{{- /* /rss.xml: same feed the Nuxt and Lume versions produced. Links and GUIDs
  keep the exact same format (no trailing slash) so feed readers don't see the
  items as new. Rendered as plain text (see hugo.toml), so escaping is manual. */ -}}
{{- $site := "https://salvatorelaisa.blog" -}}
{{- $rfc1123 := "Mon, 02 Jan 2006 15:04:05 GMT" -}}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ partial "xml-escape.html" site.Params.siteTitle }}</title>
		<link>{{ $site }}</link>
		<description>{{ partial "xml-escape.html" site.Params.siteDescription }}</description>
		<language>it</language>
		<lastBuildDate>{{ now.UTC.Format $rfc1123 }}</lastBuildDate>
		<atom:link href="{{ $site }}/rss.xml" rel="self" type="application/rss+xml" />
{{- range first 20 (partial "posts.html") }}
{{- $link := printf "%s/post/%s" $site .File.ContentBaseName }}
		<item>
			<title>{{ partial "xml-escape.html" (.Title | default "Untitled") }}</title>
			<link>{{ partial "xml-escape.html" $link }}</link>
			<guid isPermaLink="true">{{ partial "xml-escape.html" $link }}</guid>
			<pubDate>{{ .Date.UTC.Format $rfc1123 }}</pubDate>
{{- with .Params.summary }}
			<description>{{ partial "xml-escape.html" . }}</description>
{{- end }}
{{- range .Params.tags }}
			<category>{{ partial "xml-escape.html" . }}</category>
{{- end }}
{{- with partial "first-image.html" . }}
			<enclosure url="{{ partial "xml-escape.html" . }}" type="image/webp" />
{{- end }}
		</item>
{{- end }}
	</channel>
</rss>
