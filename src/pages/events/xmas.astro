---
import { getEntry, render } from "astro:content";
import HalloweenSection from "../../components/HalloweenSection.astro";
import Tip from "../../components/Tip.astro";
import Base from "../../layouts/Base.astro";

const entry = await getEntry("pages", "xmas");
const { Content } = await render(entry!);
---

<Base>
	<article class="content xmas-page">
		<h1>{entry!.data.title}</h1>
		<div><Content /></div>

		{(entry!.data.sections ?? []).map((section) => <HalloweenSection section={section} />)}

		<hr />
	</article>
	<Tip />
</Base>
