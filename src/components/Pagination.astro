---
interface Props {
	page: number;
	totalPages: number;
}

const { page, totalPages } = Astro.props;
const prev = page - 1;
const next = page + 1;
---

<div class="pagination">
	<nav aria-label="Paginazione articoli">
		{
			prev > 0 ? (
				<a class="prev" href={`/post/page/${prev}`} rel="prev">&larr; Precedente</a>
			) : (
				<span class="prev" aria-disabled="true">&larr; Precedente</span>
			)
		}

		<span class="current" aria-current="page">Pagina {page} di {totalPages}</span>

		{
			next <= totalPages ? (
				<a class="next" href={`/post/page/${next}`} rel="next">Successivo &rarr;</a>
			) : (
				<span class="next" aria-disabled="true">Successivo &rarr;</span>
			)
		}
	</nav>
</div>
