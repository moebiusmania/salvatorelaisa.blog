---
import { NOW_WORK } from "../../utils/now.ts";

const { className } = Astro.props as { className?: string };
---

<article class:list={["now-card now-work", className]}>
	<p class="now-card-kicker">Al lavoro</p>
	<h2>{NOW_WORK.role}</h2>
	<p class="now-work-company">{NOW_WORK.company}</p>
	<p class="now-work-city">
		<span aria-label="luogo" role="img">📍</span> {NOW_WORK.city}
	</p>
</article>
