{{- /* Standalone routes (were pages/*.vto). Their data lives in data/gen. */ -}}
{{- $routes := slice
  (dict "path" "about" "layout" "about")
  (dict "path" "books" "layout" "books")
  (dict "path" "devices" "layout" "devices")
  (dict "path" "now" "layout" "now" "params" (dict
    "metaTitle" "Salvatore Laisa - Adesso"
    "metaDescription" "Una fotografia del presente, ma con i dati invece che con la pellicola."
    "og" (dict
      "url" "https://salvatorelaisa.blog/now"
      "description" "Una fotografia del presente, ma con i dati invece che con la pellicola."
      "image" "https://salvatorelaisa.blog/static/images/twitter-card.png")))
  (dict "path" "events/halloween" "layout" "halloween")
  (dict "path" "events/xmas" "layout" "xmas")
-}}
{{- range $routes }}
  {{- $.AddPage (merge . (dict "kind" "page" "type" "route" "title" .layout)) }}
{{- end }}
